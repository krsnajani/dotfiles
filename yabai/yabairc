#!/usr/bin/env sh

# ==========================================
# 1. SCRIPTING ADDITION (SA)
# ==========================================
sudo yabai --load-sa
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"

# ==========================================
# 2. LAYOUT & GAPS (Matching Sway 5px gaps)
# ==========================================
yabai -m config layout                       bsp
yabai -m config top_padding                  10
yabai -m config bottom_padding               5
yabai -m config left_padding                 5
yabai -m config right_padding                5
yabai -m config window_gap                   5

# ==========================================
# 3. BORDERS & SHADOWS (default_border pixel 4)
# ==========================================
yabai -m config window_border                on
yabai -m config window_border_width          4
yabai -m config window_border_radius         0
yabai -m config active_window_border_color   0xff7cafc2  # base16 accent (cyan/blue)
yabai -m config normal_window_border_color   0xff383838  # base02 dark border
yabai -m config window_shadow                off

# ==========================================
# 4. FOCUS & MOUSE (focus_follows_mouse)
# ==========================================
yabai -m config focus_follows_mouse          autoraise
yabai -m config mouse_follows_focus          off
yabai -m config mouse_modifier               cmd
yabai -m config mouse_action1                move
yabai -m config mouse_action2                resize
yabai -m config mouse_drop_action            swap

# ==========================================
# 5. WINDOW RULES (Float utilities & Choose)
# ==========================================
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Archive Utility$" manage=off
yabai -m rule --add app="^choose$" manage=off layer=above
yabai -m rule --add app="^Emacs$" role=".*" subrole=".*" manage=on
